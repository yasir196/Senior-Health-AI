PEXELS_API_KEY=your_pexels_api_key
PIXABAY_API_KEY=your_pixabay_api_key
OPENAI_API_KEY=optional_for_visual_validation
# Optional Avatar Timing Sync override. Keep whisper-1 for verbose JSON + word/segment timestamps.
OPENAI_TRANSCRIPTION_MODEL=whisper-1
# Downstream Runware image generation (never stored in project manifests/logs)
RUNWARE_API_KEY=your_runware_api_key
