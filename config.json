{
  "channel_name": "Evidence After 60",
  "host_name": "Adrian Westbrook",
  "host_title": "Health Educator",
  "doctor_name": "",
  "doctor_mode": false,
  "credentials_claim": false,
  "target_runtime_minutes": 25,
  "target_runtime_range_minutes": [
    23,
    28
  ],
  "language": "English",
  "audience": "US adults over 60",
  "avatar_style": "virtual_educational_presenter",
  "default_avatar_look": "calm adult educational presenter, non-clinician identity",
  "voice_provider": "ElevenLabs",
  "voice_model": "V3",
  "voice_workflow": "studio",
  "voice_director_enabled": true,
  "voice_script_suffix": "06a_voice_script.md",
  "cta_mode": "generic_if_channel_name_empty",
  "medical_disclaimer_required": true,
  "production_mode": "talking_head",
  "supported_production_modes": [
    "talking_head",
    "documentary"
  ],
  "thumbnail_style": "high-contrast senior health YouTube thumbnail",
  "script_tone": "warm, evidence-first, respectful, medically careful",
  "writer_model": "claude-opus-4.8",
  "writer_mode": "outline_to_script",
  "narrative_qa_enabled": true,
  "visual_director": {
    "min_relevance_score": 70,
    "allow_weak_matches": false,
    "max_downloads_per_scene": 1,
    "repetition_window": 8,
    "max_same_action_in_window": 2,
    "max_same_shot_consecutive": 3,
    "prefer_vertical_source": false,
    "preferred_orientation": "landscape",
    "enable_visual_mode_override": true,
    "dry_run": true,
    "min_semantic_score": 75,
    "require_subject_match": true,
    "require_action_match": true,
    "prevent_duplicate_assets": true,
    "detect_near_duplicates": true,
    "candidate_pool_size": 15,
    "max_same_creator_assets": 3,
    "show_top_rejected_candidates": 3,
    "enable_vision_validation": true,
    "vision_validation_model": "gpt-4o-mini",
    "vision_validation_required": true
  },
  "codex_cli_command": "codex.cmd exec --sandbox workspace-write --skip-git-repo-check {prompt}",
  "direct_run_enabled": true,
  "narrative_qa_output": "14_narrative_qa.md",
  "medical_gate_2_output": "15_medical_gate_2.md",
  "project_summary_output": "16_project_summary.md",
  "production_defaults": {
    "avatar": 40,
    "ai_images": 30,
    "stock": 10,
    "overlays": 20
  },
  "system_version": "3.4",
  "speech_optimizer_required_for_production": true,
  "allow_production_override": false,
  "dashboard_progress_mode": "weighted",
  "run_log_dir": "RunLogs",
  "narration_words_per_minute": 145,
  "writer_minimum_words": 300,
  "writer_required_headings": [
    "Hook",
    "Introduction",
    "Main Content",
    "Conclusion"
  ],
  "writer_workspace_enabled": true,
  "writer_backup_on_overwrite": true,
  "auto_revision_enabled": true,
  "revision_backup_enabled": true,
  "writer_separate_outputs": true,
  "production_cleaner_required": true,
  "production_clean_report": "production_clean_report.md",
  "auto_stage_progression": true,
  "qa_dashboard_enabled": true,
  "quality_metrics_enabled": true,
  "writer_output_files": [
    "06_final_script.md",
    "06_runtime_report.md",
    "06_retention_report.md",
    "06_medical_review.md",
    "06_humanization_report.md"
  ],
  "production_lock_2_enabled": true,
  "avatar_transcription_model": "whisper-1",
  "avatar_alignment_threshold": 92.0,
  "openai_api_key_env": "OPENAI_API_KEY",
  "avatar_timing_sync_enabled": true,
  "timeline_builder_enabled": true,
  "capcut_export_enabled": true,
  "capcut_supported_schema": "CapCut Desktop 6.x-9.x plain-JSON draft schema",
  "visual_diversity": {
    "enabled": true,
    "rolling_window": 10,
    "max_same_core_family_in_window": 2,
    "max_same_core_signature_similarity": 0.78,
    "max_project_family_share": 0.18,
    "max_same_composition_in_window": 2,
    "max_same_action_in_window": 2,
    "max_same_object_relationship_in_window": 2,
    "max_same_family_consecutive": 2,
    "allow_intentional_continuity": true,
    "max_rewrite_attempts": 4,
    "max_convergence_passes": 6
  },
  "semantic_coherence": {
    "enabled": true,
    "max_correction_passes": 4,
    "max_prompt_corrections": 3
  }
}
